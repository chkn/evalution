{
  "name": "@evalution/typesafe-sdk",
  "version": "1.0.5",
  "description": "Helpers for integrating TypeSafe System One prompts with Evalution",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
