  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@typesafe-ai/sdk": ">=0.6.0-0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsdown": "^0.22.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "evalution",
    "typesafe",
    "system-one",
    "ai",
    "prompt"
  ],
  "license": "MIT"
}
