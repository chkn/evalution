{
  "name": "@evalution/typesafe-sdk",
  "version": "1.0.8",
  "description": "Helpers for integrating TypeSafe System One prompts with Evalution",
  "type": "module",
  "exports": {
    ".": {
      "evalution-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "evalution-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@typesafe-ai/sdk": ">=0.6.0-0",
    "typescript": ">=5.3.3-0 <7.0.0-0",
    "ts-proppy": "0.3.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsdown": "^0.22.1",
    "typescript": "^5.3.3",
    "ts-proppy": "0.3.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "ts-proppy": {
      "optional": true
    }
  },
  "dependencies": {
    "@evalution/sdk": "1.0.8"
  },
  "keywords": [
    "evalution",
    "typesafe",
    "system-one",
    "ai",
    "prompt"
  ],
  "license": "MIT"
}
