{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["evalution-source"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "lib": ["ESNext"]
  },
  "include": ["src"]
}
